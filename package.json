{
  "name": "gemas-ia",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "El radar de las joyas ocultas de la IA",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "collect": "node scripts/collect-all.mjs",
    "build:dataset": "node scripts/build-dataset.mjs",
    "draft": "node scripts/generate-weekly-draft.mjs",
    "charts": "node scripts/generate-chart-assets.mjs",
    "test": "node --test tests/scoring.test.mjs tests/movements.test.mjs tests/dataset.test.mjs",
    "pipeline": "npm run collect && npm run build:dataset && npm run charts"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@observablehq/plot": "^0.6.17",
    "astro": "^7.2.4",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@resvg/resvg-js": "^2.6.2"
  }
}
