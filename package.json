{
  "name": "gemas-ia",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "El radar de las joyas ocultas de la IA",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "collect": "node scripts/collect-all.mjs",
    "collect:usage": "node scripts/collect-openrouter-usage.mjs",
    "benchmarks": "node scripts/collect-benchmarks.mjs",
    "backfill": "node scripts/backfill.mjs",
    "build:dataset": "node scripts/build-dataset.mjs",
    "draft": "node scripts/generate-weekly-draft.mjs",
    "charts": "node scripts/generate-chart-assets.mjs",
    "test": "node --test tests/scoring.test.mjs tests/movements.test.mjs tests/labs.test.mjs tests/quality.test.mjs tests/benchmark-match.test.mjs tests/dataset.test.mjs",
    "pipeline": "npm run collect && npm run collect:usage && npm run build:dataset && npm run charts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource-variable/fraunces": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.7",
    "@observablehq/plot": "^0.6.17",
    "astro": "^7.2.4",
    "fflate": "^0.8.2",
    "marked": "^18.0.10"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
