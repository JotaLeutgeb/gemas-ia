---
import { SITE, NAV } from "../config/site.js";
import "../styles/global.css";

const { title = SITE.name, description = SITE.description } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href) => {
  const target = href.replace(/\/$/, "") || "/";
  return currentPath === target ? "page" : undefined;
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="brand"><span class="gem">◆</span> {SITE.name}</a>
        <nav class="main-nav">
          {NAV.map((item) => <a href={item.href} aria-current={isActive(item.href)}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          Hecho con curiosidad por {SITE.author}. Datos de
          {SITE.sources.map((s, i) => (
            <>
              {i > 0 && " y "}<a href={s.url} rel="noopener">{s.label}</a>
            </>
          ))}, procesados con metodología abierta.
        </p>
        <p class="small">
          Proyecto abierto: <a href={SITE.repoUrl} rel="noopener">código y datos en GitHub</a> ·
          snapshots diarios versionados · <a href="/metodologia/">cómo se calcula todo</a>
        </p>
      </div>
    </footer>
  </body>
</html>
