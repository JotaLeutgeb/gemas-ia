---
import fs from "node:fs/promises";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../config/site.js";

export async function getStaticPaths() {
  let dataset = null;
  try {
    dataset = JSON.parse(await fs.readFile(path.resolve("public/data/dataset.json"), "utf8"));
  } catch {
    return [];
  }
  return (dataset.models ?? []).map((model) => ({ params: { slug: model.urlSlug }, props: { model } }));
}

const { model } = Astro.props;
const fmtPct = (v) => (Number.isFinite(v) ? `${(Math.exp(v) - 1) >= 0 ? "+" : ""}${((Math.exp(v) - 1) * 100).toFixed(1)}%` : "n/d");
const fmtNum = (n) => (n == null ? "n/d" : n.toLocaleString("es"));

const KEY_BENCHMARKS = ["epoch_capabilities_index", "gpqa_diamond", "swe_bench_verified", "math_level_5", "hle", "mmlu_external", "terminalbench"];
const BENCH_LABELS = {
  epoch_capabilities_index: "Epoch Capabilities Index",
  gpqa_diamond: "GPQA Diamond (ciencia nivel PhD)",
  swe_bench_verified: "SWE-bench Verified (issues reales)",
  math_level_5: "MATH Level 5 (competición)",
  hle: "Humanity's Last Exam",
  mmlu_external: "MMLU (conocimiento general)",
  terminalbench: "Terminal-Bench (agente terminal)",
};
const benchmarks = (model.benchmarks ?? [])
  .slice()
  .sort((a, b) => {
    const ia = KEY_BENCHMARKS.indexOf(a.benchmark);
    const ib = KEY_BENCHMARKS.indexOf(b.benchmark);
    return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib);
  });
const hasBenchmarks = benchmarks.length > 0;
const hasUsage = (model.series.usageTokens ?? []).length >= 2;
---

<BaseLayout title={`${model.name} — Gemas IA`} description={`Evolución histórica, precios y proyección de ${model.name}.`}>
  <section class="hero">
    <h1>{model.name}</h1>
    <p class="lede muted">
      de {model.provider ?? "proveedor desconocido"} ·
      {model.famous ? <span class="badge famous">modelo famoso</span> : <span class="badge gem">candidato a joya</span>}
    </p>
    <p class="small">
      {model.links?.huggingface && <a href={model.links.huggingface} rel="noopener">HuggingFace ↗</a>}
      {model.links?.openrouter && <> · <a href={model.links.openrouter} rel="noopener">OpenRouter ↗</a></>}
    </p>
  </section>

  <section class="kpis">
    <div class="kpi"><div class="value">{fmtNum(model.downloads)}</div><div class="label">descargas acumuladas</div></div>
    <div class="kpi"><div class="value">{fmtNum(model.likes)}</div><div class="label">likes</div></div>
    <div class="kpi"><div class="value">{model.promptUsdPerM == null ? "n/d" : `$${model.promptUsdPerM.toFixed(2)}`}</div><div class="label">$ / 1M entrada</div></div>
    <div class="kpi"><div class="value">{model.completionUsdPerM == null ? "n/d" : `$${model.completionUsdPerM.toFixed(2)}`}</div><div class="label">$ / 1M salida</div></div>
    <div class="kpi"><div class="value">{model.contextLength ? `${Math.round(model.contextLength / 1000)}k` : "n/d"}</div><div class="label">ventana de contexto</div></div>
    <div class="kpi"><div class="value">{model.gemScore != null ? model.gemScore.toFixed(2) : "—"}</div><div class="label">score joya</div></div>
  </section>

  <section class="card">
    <h2>Evolución y proyección</h2>
    <p class="small muted">
      Línea verde: descargas acumuladas observadas. Línea amarilla punteada: extrapolación log-lineal
      a 180 días con su banda de confianza. Cuantos más puntos tengamos, más honesta es la banda.
    </p>
    <div id="chart-downloads" class="chart-container" role="img" aria-label="Serie histórica de descargas acumuladas con proyección a 180 días" data-model={JSON.stringify(model)}></div>
    {hasUsage && (
      <>
        <h2 style="margin-top:2rem">Uso real (tokens por día en OpenRouter)</h2>
        <p class="small muted">
          Descargas mide curiosidad; tokens miden uso genuino. Esta serie viene del Data API
          público de OpenRouter (top diario por volumen).
        </p>
        <div id="chart-usage" class="chart-container" role="img" aria-label="Serie histórica de tokens procesados por día" data-model={JSON.stringify(model)}></div>
      </>
    )}
  </section>

  {hasBenchmarks && (
    <section class="card">
      <h2>Desempeño</h2>
      <p class="section-note">
        Scores compilados por Epoch AI (evaluaciones propias y fuentes externas agregadas),
        matcheados heurísticamente al modelo. Verificá siempre la fuente antes de citar un número.
      </p>
      <table class="data">
        <thead>
          <tr><th>Benchmark</th><th class="num">Score</th><th style="width:34%"></th><th>Fuente</th></tr>
        </thead>
        <tbody>
          {benchmarks.slice(0, 14).map((b) => {
            const isIndex = b.benchmark === "epoch_capabilities_index";
            const display = isIndex ? b.score.toFixed(1) : (Math.min(b.score, 1) * 100).toFixed(1);
            const pct = Math.max(0, Math.min(isIndex ? b.score / 2 : b.score, 1)) * 100;
            return (
              <tr>
                <td>{BENCH_LABELS[b.benchmark] ?? b.benchmark}</td>
                <td class="num">{display}</td>
                <td><span class="scorebar" aria-hidden="true"><span style={`width:${pct}%`}></span></span></td>
                <td>{b.source === "epoch" ? "Epoch AI" : "externo"}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
      {benchmarks.length > 14 && (
        <p class="small muted">+{benchmarks.length - 14} benchmarks más en el dataset crudo.</p>
      )}
      <p class="small muted">ECI es un índice compuesto (no un porcentaje); el resto se muestra en escala 0–100.</p>
    </section>
  )}

  <section class="card">
    <h2>Proyecciones</h2>
    {model.metrics.forecastDownloads90d || model.metrics.forecastDownloads180d || Number.isFinite(model.metrics.momentum) ? (
      <table class="data">
        <thead>
          <tr><th>Métrica</th><th class="num">90 días</th><th class="num">180 días</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>Descargas proyectadas</td>
            <td class="num">{model.metrics.forecastDownloads90d ? fmtNum(Math.round(model.metrics.forecastDownloads90d.center)) : "n/d"}</td>
            <td class="num">{model.metrics.forecastDownloads180d ? fmtNum(Math.round(model.metrics.forecastDownloads180d.center)) : "n/d"}</td>
          </tr>
          <tr>
            <td>Banda de confianza (±1σ)</td>
            <td class="num">
              {model.metrics.forecastDownloads90d
                ? `${fmtNum(Math.round(model.metrics.forecastDownloads90d.low))} – ${fmtNum(Math.round(model.metrics.forecastDownloads90d.high))}`
                : "n/d"}
            </td>
            <td class="num">
              {model.metrics.forecastDownloads180d
                ? `${fmtNum(Math.round(model.metrics.forecastDownloads180d.low))} – ${fmtNum(Math.round(model.metrics.forecastDownloads180d.high))}`
                : "n/d"}
            </td>
          </tr>
          <tr>
            <td>Momentum 28d (crecimiento relativo)</td>
            <td class="num" colspan="2">{fmtPct(model.metrics.momentum)}</td>
          </tr>
        </tbody>
      </table>
    ) : (
      <p class="small muted">Sin proyección todavía: se necesitan al menos 4 puntos en la serie.</p>
    )}
  </section>

  <p class="small muted">
    ¿Cómo se calculan estos números? Todo está abierto en la <a href={withBase("/metodologia/")}>metodología</a>.
  </p>
</BaseLayout>

<script>
  import { mountModelPage } from "../../scripts/charts.js";
  document.addEventListener("DOMContentLoaded", () => mountModelPage());
</script>
