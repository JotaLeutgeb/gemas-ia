---
import fs from "node:fs/promises";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../config/site.js";

export async function getStaticPaths() {
  let dataset = null;
  try {
    dataset = JSON.parse(await fs.readFile(path.resolve("public/data/dataset.json"), "utf8"));
  } catch {
    return [];
  }
  return (dataset.models ?? []).map((model) => ({ params: { slug: model.urlSlug }, props: { model } }));
}

const { model } = Astro.props;
const fmtPct = (v) => (Number.isFinite(v) ? `${(Math.exp(v) - 1) >= 0 ? "+" : ""}${((Math.exp(v) - 1) * 100).toFixed(1)}%` : "n/d");
const fmtNum = (n) => (n == null ? "n/d" : n.toLocaleString("es"));
const fmtPrice = (p) => {
  if (p == null) return "n/d";
  if (p === 0) return "gratis";
  return p >= 1 ? `$${p.toFixed(2)}` : `$${p.toFixed(3)}`;
};

const KEY_BENCHMARKS = ["swe_bench_verified", "terminalbench", "cursorbench", "scicode", "frontiercode", "epoch_capabilities_index", "gpqa_diamond", "math_level_5", "hle", "mmlu"];
const BENCH_LABELS = {
  swe_bench_verified: "SWE-bench Verified (issues reales)",
  terminalbench: "Terminal-Bench (agente terminal)",
  cursorbench: "Cursor Bench (tareas de editor)",
  scicode: "SciCode (código científico)",
  frontiercode: "FrontierCode",
  epoch_capabilities_index: "Epoch Capabilities Index (general)",
  gpqa_diamond: "GPQA Diamond (ciencia nivel PhD)",
  math_level_5: "MATH Level 5 (competición)",
  hle: "Humanity's Last Exam",
  mmlu: "MMLU (conocimiento general)",
};
const benchmarks = (model.benchmarks ?? [])
  .slice()
  .sort((a, b) => {
    const ia = KEY_BENCHMARKS.indexOf(a.benchmark);
    const ib = KEY_BENCHMARKS.indexOf(b.benchmark);
    return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib);
  });
const hasBenchmarks = benchmarks.length > 0;
const hasUsage = (model.series.usageTokens ?? []).length >= 2;
const hasPrices = (model.series.promptUsdPerM ?? []).length >= 2 || (model.series.completionUsdPerM ?? []).length >= 2;

const chartModel = JSON.stringify({
  series: {
    usageTokens: model.series.usageTokens ?? [],
    promptUsdPerM: model.series.promptUsdPerM ?? [],
    completionUsdPerM: model.series.completionUsdPerM ?? [],
  },
});
const hasForecast = model.metrics.forecastUsage90d || model.metrics.forecastUsage180d;
---

<BaseLayout title={`${model.name} — Gemas IA`} description={`Calidad, precios y uso real de ${model.name} (${model.labLabel}) frente a los demás líderes.`}>
  <section class="hero">
    <h1>{model.name}</h1>
    <p class="lede muted">
      {model.labLabel}
      {model.createdAt && <> · en el catálogo desde {model.createdAt.slice(0, 10)}</>}
      {model.onEfficiencyFrontier && <> · <span class="badge gem">frontera eficiente</span></>}
    </p>
    <p class="small">
      {model.links?.openrouter && <a href={model.links.openrouter} rel="noopener">OpenRouter ↗</a>}
       · <a href={withBase("/joyas/")}>ranking de mejor valor</a>
    </p>
  </section>

  <section class="kpis">
    <div class="kpi"><div class="value">{model.quality != null ? model.quality.index.toFixed(1) : "—"}</div><div class="label">índice de código</div></div>
    <div class="kpi"><div class="value">{model.performanceRank != null ? `#${model.performanceRank}` : "—"}</div><div class="label">rank de código</div></div>
    <div class="kpi"><div class="value">{fmtPrice(model.blendedUsdPerM)}</div><div class="label">$ / 1M mezclado</div></div>
    <div class="kpi"><div class="value">{model.valueRank != null ? `#${model.valueRank}` : "—"}</div><div class="label">rank de valor</div></div>
    <div class="kpi"><div class="value">{model.quality?.general?.index != null ? model.quality.general.index.toFixed(0) : "—"}</div><div class="label">índice general (ref.)</div></div>
    <div class="kpi"><div class="value">{model.contextLength ? `${Math.round(model.contextLength / 1000)}k` : "n/d"}</div><div class="label">ventana de contexto</div></div>
    <div class="kpi"><div class="value">{hasUsage ? fmtNum(Math.round(model.series.usageTokens.at(-1)?.value ?? 0)) : "n/d"}</div><div class="label">tokens/día (último dato)</div></div>
  </section>

  {(hasPrices || hasUsage) && (
    <section class="card">
      {hasPrices && (
        <>
          <h2>Historial de precios</h2>
          <p class="small muted">
            Precio por millón de tokens observado cada día en OpenRouter. Verde: entrada; amarillo: salida.
            Las caídas bruscas quedan registradas en <a href={withBase("/movimientos/")}>movimientos</a>.
          </p>
          <div id="chart-prices" class="chart-container" role="img" aria-label="Serie histórica de precios por millón de tokens" data-model={chartModel}></div>
        </>
      )}
      {hasUsage && (
        <>
          <h2 style={hasPrices ? "margin-top:2rem" : ""}>Uso real (tokens por día en OpenRouter)</h2>
          <p class="small muted">
            Tokens procesados por día a través de OpenRouter: tracción genuina entre desarrolladores,
            no descargas de curiosos.
          </p>
          <div id="chart-usage" class="chart-container" role="img" aria-label="Serie histórica de tokens procesados por día" data-model={chartModel}></div>
        </>
      )}
    </section>
  )}

  {hasBenchmarks && (
    <section class="card">
      <h2>Desempeño</h2>
      <p class="section-note">
        Scores compilados por Epoch AI (evaluaciones propias y fuentes externas agregadas),
        matcheados heurísticamente al modelo, normalizados a escala 0–100. Los primeros cinco
        benchmarks alimentan el índice de código del sitio; el resto es referencia. Verificá siempre
        la fuente antes de citar un número.
      </p>
      <table class="data">
        <thead>
          <tr><th>Benchmark</th><th class="num">Score</th><th style="width:34%"></th><th>Fuente</th></tr>
        </thead>
        <tbody>
          {benchmarks.slice(0, 14).map((b) => {
            const isIndex = b.benchmark === "epoch_capabilities_index";
            const display = isIndex ? b.score.toFixed(1) : Math.min(b.score, 100).toFixed(1);
            const pct = Math.max(0, Math.min(isIndex ? b.score / 2 : b.score, 100));
            return (
              <tr>
                <td>{BENCH_LABELS[b.benchmark] ?? b.benchmark}</td>
                <td class="num">{display}</td>
                <td><span class="scorebar" aria-hidden="true"><span style={`width:${pct}%`}></span></span></td>
                <td>{b.source === "epoch" ? "Epoch AI" : "externo"}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
      {benchmarks.length > 14 && (
        <p class="small muted">+{benchmarks.length - 14} benchmarks más en el dataset crudo.</p>
      )}
      <p class="small muted">
        Los benchmarks se muestran normalizados a escala 0–100; ECI es un índice compuesto propio de Epoch (escala distinta).
      </p>
    </section>
  )}

  <section class="card">
    <h2>Tendencia de uso</h2>
    {hasForecast || Number.isFinite(model.metrics.momentumUsage) ? (
      <table class="data">
        <thead>
          <tr><th>Métrica</th><th class="num">90 días</th><th class="num">180 días</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>Tokens/día proyectados</td>
            <td class="num">{model.metrics.forecastUsage90d ? fmtNum(Math.round(model.metrics.forecastUsage90d.center)) : "n/d"}</td>
            <td class="num">{model.metrics.forecastUsage180d ? fmtNum(Math.round(model.metrics.forecastUsage180d.center)) : "n/d"}</td>
          </tr>
          <tr>
            <td>Banda de confianza (±1σ)</td>
            <td class="num">
              {model.metrics.forecastUsage90d
                ? `${fmtNum(Math.round(model.metrics.forecastUsage90d.low))} – ${fmtNum(Math.round(model.metrics.forecastUsage90d.high))}`
                : "n/d"}
            </td>
            <td class="num">
              {model.metrics.forecastUsage180d
                ? `${fmtNum(Math.round(model.metrics.forecastUsage180d.low))} – ${fmtNum(Math.round(model.metrics.forecastUsage180d.high))}`
                : "n/d"}
            </td>
          </tr>
          <tr>
            <td>Momentum de uso 28d (crecimiento relativo)</td>
            <td class="num" colspan="2">{fmtPct(model.metrics.momentumUsage)}</td>
          </tr>
        </tbody>
      </table>
    ) : (
      <p class="small muted">Sin proyección todavía: se necesitan al menos 4 puntos en la serie de uso.</p>
    )}
  </section>

  <p class="small muted">
    ¿Cómo se calculan estos números? Todo está abierto en la <a href={withBase("/metodologia/")}>metodología</a>.
  </p>
</BaseLayout>

<script>
  import { mountModelPage } from "../../scripts/charts.js";
  document.addEventListener("DOMContentLoaded", () => mountModelPage());
</script>
