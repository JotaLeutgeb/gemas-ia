---
import fs from "node:fs/promises";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../config/site.js";

let dataset = null;
try {
  dataset = JSON.parse(await fs.readFile(path.resolve("public/data/dataset.json"), "utf8"));
} catch {
  dataset = null;
}
const models = dataset?.models ?? [];
const labOrder = new Map((dataset?.labs ?? []).map((l, i) => [l.id, i]));

const byLab = new Map();
for (const m of models) {
  const key = m.labId ?? "otros";
  if (!byLab.has(key)) byLab.set(key, { id: key, label: m.labLabel ?? key, models: [] });
  byLab.get(key).models.push(m);
}
const groups = [...byLab.values()].sort(
  (a, b) => (labOrder.get(a.id) ?? 99) - (labOrder.get(b.id) ?? 99)
);

const fmtPrice = (p) => (p == null ? null : p === 0 ? "gratis" : p >= 1 ? `$${p.toFixed(2)}/1M` : `$${p.toFixed(3)}/1M`);
---

<BaseLayout title="Modelos por laboratorio — Gemas IA" description="La línea completa de cada lab líder en el radar de Gemas IA: calidad, precios y contexto.">
  <section class="hero">
    <h1>Modelos por <span class="gem">laboratorio</span></h1>
    <p class="lede">
      {models.length} modelos de los labs líderes comparados. Cada ficha incluye benchmarks,
      historial de precios y uso real cuando hay datos suficientes.
    </p>
    {dataset?.generatedAt && <p class="small muted">Última actualización: {dataset.generatedAt.slice(0, 10)}</p>}
  </section>

  {groups.map(({ label, models: list }) => (
    <section class="card">
      <h2>{label} <span class="muted small">({list.length})</span></h2>
      <div class="model-grid">
        {list.map((m) => (
          <a href={withBase(`/modelos/${m.urlSlug}/`)} class="model-card">
            <div class="name">{m.name}</div>
            <div class="meta">
              {m.quality != null && <>◆ {m.quality.index.toFixed(1)} · </>}
              {fmtPrice(m.promptUsdPerM) != null && <>💵 {fmtPrice(m.promptUsdPerM)} · </>}
              {m.contextLength ? `${Math.round(m.contextLength / 1000)}k` : "contexto n/d"}
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}

  {models.length === 0 && (
    <section class="card">
      <p class="chart-empty">Todavía no se recolectaron datos. El pipeline corre automáticamente cada día.</p>
    </section>
  )}
</BaseLayout>
