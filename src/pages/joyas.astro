---
import fs from "node:fs/promises";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../config/site.js";

let dataset = null;
try {
  dataset = JSON.parse(await fs.readFile(path.resolve("public/data/dataset.json"), "utf8"));
} catch {
  dataset = null;
}

const ranked = [...(dataset?.models ?? [])]
  .filter((m) => m.valueScore !== null)
  .sort((a, b) => a.valueRank - b.valueRank)
  .slice(0, 30);
const withoutQuality = (dataset?.models ?? []).length - (dataset?.totals?.withQuality ?? 0);

const fmtPrice = (p) => {
  if (p == null) return "n/d";
  if (p === 0) return "gratis";
  return p >= 1 ? `$${p.toFixed(2)}` : `$${p.toFixed(3)}`;
};
---

<BaseLayout title="Mejor valor: calidad por dólar — Gemas IA" description="Qué modelo líder da la máxima calidad por dólar: índice Epoch AI dividido precio mezclado, actualizado a diario con datos propios.">
  <section class="hero">
    <h1>Ranking de <span class="gem">mejor valor</span></h1>
    <p class="lede">
      Solo modelos de labs líderes, ordenados por eficiencia para programar:
      <strong>índice de código ÷ precio mezclado</strong> por millón de tokens (75% entrada / 25% salida).
      Acá las joyas no son oscuras: son los líderes que más capacidad de código te dan por cada dólar.
    </p>
  </section>

  <section class="card">
    {ranked.length > 0 ? (
      <table class="data">
        <thead>
          <tr>
            <th>#</th>
            <th>Modelo</th>
            <th>Lab</th>
            <th class="num">Código</th>
            <th class="num">$ / 1M mezclado</th>
            <th class="num">pts × $</th>
            <th class="num">Contexto</th>
          </tr>
        </thead>
        <tbody>
          {ranked.map((m) => (
            <tr>
              <td>{m.valueRank}</td>
              <td><a href={withBase(`/modelos/${m.urlSlug}/`)}>{m.name}</a>{m.onEfficiencyFrontier && <> <span class="badge gem">frontera</span></>}</td>
              <td class="muted">{m.labLabel}</td>
              <td class="num">{m.quality.index.toFixed(1)}</td>
              <td class="num">{fmtPrice(m.blendedUsdPerM)}</td>
              <td class="num">{m.valueScore.toLocaleString("es", { maximumFractionDigits: 0 })}</td>
              <td class="num">{m.contextLength ? `${Math.round(m.contextLength / 1000)}k` : "n/d"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p class="chart-empty">
        Todavía no hay scores de calidad matcheados contra precios. Volvé pronto o leé
        <a href={withBase("/metodologia/")}> cómo se calcula el score</a>.
      </p>
    )}
  </section>

  <p class="small muted">
    ¿Por qué no aparece tu modelo favorito? O no pertenece a un lab del universo comparado,
    o todavía no tiene benchmarks en Epoch AI, o no está publicado en OpenRouter con precio.
    {withoutQuality > 0 && <> Hoy hay {withoutQuality} modelos en el radar esperando score.</>}
    Todo está explicado en la <a href={withBase("/metodologia/")}>metodología</a>.
  </p>
</BaseLayout>
