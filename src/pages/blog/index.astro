---
import fs from "node:fs/promises";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../config/site.js";
import { loadPublishedEditions } from "../../lib/ediciones.js";

const postFiles = Object.entries(
  import.meta.glob("../../content/posts/*.md", { eager: true })
).map(([file, mod]) => ({
  slug: file.split("/").pop().replace(/\.md$/, ""),
  type: "ensayo",
  href: withBase(`/blog/${file.split("/").pop().replace(/\.md$/, "")}/`),
  ...(mod.frontmatter ?? {}),
}));

let editions = [];
try {
  editions = (await loadPublishedEditions()).map((e) => ({
    ...e,
    type: "edición",
    href: withBase(`/ediciones/${e.slug}/`),
  }));
} catch {}

const items = [...editions, ...postFiles].sort((a, b) => ((a.date ?? "") < (b.date ?? "") ? 1 : -1));
---

<BaseLayout title="Blog — Gemas IA" description="Análisis sobre el mercado de LLMs, joyas ocultas y forecasting con datos propios.">
  <section class="hero">
    <h1>Blog</h1>
    <p class="lede">Ediciones semanales del observatorio y ensayos sobre el mercado de LLMs. Nada de crónicas de lanzamiento.</p>
  </section>

  {items.length === 0 && (
    <section class="card">
      <p class="chart-empty">Todavía no hay publicaciones.</p>
    </section>
  )}

  {items.map((item) => (
    <article class="card">
      <p class="kicker">{item.type} · {item.date}</p>
      <h2><a href={item.href}>{item.title}</a></h2>
      {"excerpt" in item && item.excerpt ? (
        <p class="small muted">{item.excerpt}…</p>
      ) : (
        item.description && <p class="small muted">{item.description}</p>
      )}
    </article>
  ))}
</BaseLayout>
